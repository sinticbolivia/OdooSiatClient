<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="siat_client.SelectionDataset" owl="1">
        <select class="o_input" t-att-id="props.id" t-att-disabled="props.readonly" t-on-change="onChange">
            <option t-if="!props.required" value="">-- seleccionar --</option>
            <t t-foreach="state.options" t-as="option" t-key="option.key">
                <!-- t-attf-data-custom injects the dynamic string directly into the option attribute -->
                <option t-att-value="option.value"
                        t-att-selected="option.value === currentValue"
                        t-attf-data-custom="{{option.datasetAttr}}">
                    <t t-esc="option.label" /> (<t t-out="option.value" />)
                </option>
            </t>
        </select>
    </t>
</templates>